# Hive Studio environment. Copy to .env.local for development.
# Secrets are set by the operator (here and in Vercel), never committed.
# lib/env.ts validates these on boot; production refuses to start with gaps.

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Hive Studio

# Auth.js (Phase 2). AUTH_SECRET: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_RESEND_KEY=
EMAIL_FROM="Hive Studio <login@kitcrew.ai>"
SIGNUP_BONUS_CREDITS=0

# MongoDB Atlas (replica set required for transactions)
MONGODB_URI=
MONGODB_DB=hive-studio

# Higgsfield. HF_CREDENTIALS from console.higgsfield.ai, format key_id:key_secret
HF_API_BASE_URL=https://api.higgsfield.ai
HF_CREDENTIALS=
# At least 32 random characters: `openssl rand -hex 32`
HF_WEBHOOK_SECRET=
# Public base URL Higgsfield can reach; empty = reconcile-only (local dev)
HF_WEBHOOK_BASE_URL=

# Credits: credits = ceil(hfUsdCost * CREDIT_MARKUP / CREDIT_USD_VALUE)
CREDIT_USD_VALUE=0.01
CREDIT_MARKUP=1.5

# Stripe (test mode first). Webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_ANNUAL=
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_MEDIUM=
STRIPE_PRICE_TOPUP_LARGE=

# Cloudflare R2 (Phase 3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Who may generate in production: "admins" (default, until prices are set) or "everyone".
GENERATION_ACCESS=admins

# Vercel Cron. At least 16 random characters.
CRON_SECRET=
