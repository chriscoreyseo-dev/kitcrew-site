# Hive Studio environment. Copy to .env.local for development.
# Secrets are set by the operator (here and in Vercel), never committed.
# lib/env.ts validates these on boot; production refuses to start with gaps.

# Deployment (D-055): "standalone" = studio.kitcrew.ai (magic links + Stripe);
# "markethive" = inside MarketHive (handoff sign-in + Hive credits). One codebase.
STUDIO_MODE=standalone

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Hive Studio

# Auth.js (Phase 2). AUTH_SECRET: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_RESEND_KEY=
EMAIL_FROM="Hive Studio <login@kitcrew.ai>"
SIGNUP_BONUS_CREDITS=0

# MongoDB Atlas (replica set required for transactions)
MONGODB_URI=
MONGODB_DB=hive-studio

# Higgsfield. HF_CREDENTIALS from console.higgsfield.ai, format key_id:key_secret
HF_API_BASE_URL=https://api.higgsfield.ai
HF_CREDENTIALS=
# At least 32 random characters: `openssl rand -hex 32`
HF_WEBHOOK_SECRET=
# Public base URL Higgsfield can reach; empty = reconcile-only (local dev)
HF_WEBHOOK_BASE_URL=

# Credits: credits = ceil(hfUsdCost * CREDIT_MARKUP / CREDIT_USD_VALUE)
CREDIT_USD_VALUE=0.01
CREDIT_MARKUP=1.5

# Stripe (test mode first). Webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_ANNUAL=
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_MEDIUM=
STRIPE_PRICE_TOPUP_LARGE=

# Cloudflare R2 (Phase 3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Who may generate in production: "admins" (default, until prices are set) or "everyone".
GENERATION_ACCESS=admins

# Vercel Cron. At least 16 random characters.
CRON_SECRET=

# --- Docker hosts (Coolify, any VPS; D-059) -----------------------------------
# Run the reconciler in-process every N seconds (no Vercel Cron). 0 = off.
INTERNAL_CRON_SECONDS=0
# Apply the MongoDB indexes at boot (the Docker image has no tsx for db:init).
DB_INIT_AT_BOOT=
# Only these groups stop a production boot (comma list); others warn and
# refuse at use. Empty = every group this mode needs. dev3: db,markethive
BOOT_REQUIRED_GROUPS=
# Where outputs are kept: r2 (default) or local (a volume served at /media).
STORAGE_DRIVER=r2
LOCAL_STORAGE_DIR=/data/media

# --- markethive mode (D-056, D-057) -------------------------------------------
# MarketHive site whose wallet + sign-in this studio uses.
MARKETHIVE_BASE_URL=
# Shared with MarketHive (its MH_HIVE_STUDIO_SECRET). 32+ random chars:
# `openssl rand -hex 32`. Set by the operator on BOTH servers.
MARKETHIVE_SHARED_SECRET=
# Origins allowed to frame the studio (space separated).
MARKETHIVE_FRAME_ANCESTORS=https://markethive.com https://www.markethive.com https://dev3.markethive.com
# Where "Add credits" sends members (MarketHive's wallet page).
MARKETHIVE_CREDITS_URL=
